    "ACCESS_TEAM_DOMAIN": "steep-unit-4806.cloudflareaccess.com",
    "ACCESS_AUD": "c7b69a28d434b9df90a38033af6b6cafaf1a210ac4fb634a0ab6161f484ace42"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
