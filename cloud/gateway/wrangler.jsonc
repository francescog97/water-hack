{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "crisis2action",
  "account_id": "b58b919c2f318c56b4634925d3f84ca9",
  "main": "index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../app/frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": true
